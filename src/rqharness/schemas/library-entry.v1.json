{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joaovsales.github.io/cyber-risk-quantification-harness/schemas/library-entry.v1.json",
  "title": "Library entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entry_id",
    "parameter_family",
    "value",
    "tier",
    "source",
    "scenario_tags",
    "segment",
    "period",
    "captured_at",
    "sensitivity"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "parameter_family": {
      "type": "string",
      "pattern": "^(frequency\\.lef|frequency\\.tef|frequency\\.contact|frequency\\.action|vulnerability\\.probability|vulnerability\\.threat_capability|vulnerability\\.resistance_strength|secondary_loss\\.slef|primary_loss\\.productivity|primary_loss\\.response|primary_loss\\.replacement|primary_loss\\.fines_and_judgments|primary_loss\\.reputation|primary_loss\\.competitive_advantage|secondary_loss\\.productivity|secondary_loss\\.response|secondary_loss\\.replacement|secondary_loss\\.fines_and_judgments|secondary_loss\\.reputation|secondary_loss\\.competitive_advantage)$"
    },
    "value": {
      "$ref": "#/$defs/value"
    },
    "tier": {
      "enum": [
        "internal_data",
        "sme_estimate",
        "benchmark",
        "agent_assumption"
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "scenario_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "ransomware",
          "business_email_compromise",
          "credential_phishing",
          "third_party_breach",
          "cloud_misconfiguration",
          "ddos",
          "insider_data_theft",
          "lost_or_stolen_device",
          "other"
        ]
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "industry",
        "size_band"
      ],
      "properties": {
        "industry": {
          "type": "string",
          "pattern": "^(any|[a-z][a-z0-9_-]*)$"
        },
        "size_band": {
          "enum": [
            "smb",
            "mid_market",
            "enterprise",
            "any"
          ]
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "captured_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "stale_after_months": {
      "type": "integer",
      "minimum": 1,
      "default": 18
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential"
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 500
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "mode",
        "max",
        "unit"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "mode": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": [
            "person",
            "internal_system",
            "web",
            "benchmark_library",
            "memory"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "library_entry_id": {
          "$ref": "#/$defs/slug"
        },
        "owner_role": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "applicability_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "web",
                  "benchmark_library"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "memory"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "library_entry_id"
            ]
          }
        }
      ]
    }
  }
}
